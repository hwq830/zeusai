# 复制成 .env 后填写；.env 不要提交。各变量的含义见 server/README.md。

# 域名：两条 A 记录都指向这台 ECS 的公网 IP。
ZEUS_API_DOMAIN=api-dev.example.com
ZEUS_ADMIN_DOMAIN=admin-dev.example.com
# 能打开控制台的公网 IP（你家 / 公司出口 IP，curl ifconfig.me 查），空格分隔。
ZEUS_ADMIN_ALLOW_IPS=1.2.3.4/32

# dev：短信验证码固定、Apple/微信可用 dev:<id> 登录、模型和搜索可以是 mock。
# 环境暴露在公网，验证码别外传；接好真短信后改成 staging。
ZEUS_ENV=dev
ZEUS_DEV_SMS_CODE=246810

# 必填密钥：openssl rand -hex 32 生成。
ZEUS_PG_PASSWORD=
ZEUS_JWT_SECRET=
ZEUS_ADMIN_JWT_SECRET=
ZEUS_FILES_SECRET=
# 加密后台“API Key”页保存的模型 / 搜索 Key；设置后不要再改，改了要在后台重新填 Key。
ZEUS_SECRETS_KEY=

# 模型和搜索：先用 mock 把链路跑通；在后台“API Key”页填好并测试通过后，改成 gateway / console 重启（bocha 也行，等同 console）。
# 搜索服务商（博查 / Tavily / Brave / Serper）和主用、备用顺序都在后台「服务商」页设置。
# 也可以直接在这里填 key（后台没有启用的 Key 时才用这里的）。
ZEUS_LLM_PROVIDER=mock
ZEUS_SEARCH_PROVIDER=mock
# ZEUS_QWEN_API_KEY=
# ZEUS_DEEPSEEK_API_KEY=
# ZEUS_BOCHA_API_KEY=

# 推送（可选）：.p8 放到 deploy/cloud-dev/secrets/apns.p8，并取消下面几行注释。
# ZEUS_APNS_KEY_FILE=/run/secrets/apns.p8
# ZEUS_APNS_KEY_ID=
# ZEUS_APNS_TEAM_ID=
ZEUS_APNS_TOPIC=com.jasonhu.zeusai.app
ZEUS_APPLE_CLIENT_IDS=com.jasonhu.zeusai.app

# 境内 ECS 构建加速（香港地域不需要）：
# ZEUS_DOCKER_MIRROR=<镜像加速域名>
# ZEUS_GOPROXY=https://goproxy.cn,direct
# ZEUS_NPM_REGISTRY=https://registry.npmmirror.com/
