<!doctype html>
<html lang="{{.L.HTMLLang}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="ai-generated" content="true">
<title>{{.Title}}</title>
{{- if .Share}}
<meta name="robots" content="noindex, nofollow">
<meta property="og:title" content="{{.Title}}">
<meta property="og:description" content="{{.Headline}}">
<meta name="description" content="{{.Headline}}">
{{- end}}
<style>
:root {
  --bg: #ffffff; --fg: #1c1c1e; --muted: #6e6e73; --line: #e5e5ea; --accent: #2952cc; --card: #f5f5f7;
}
@media (prefers-color-scheme: dark) {
  :root { --bg: #000000; --fg: #f2f2f7; --muted: #98989d; --line: #2c2c2e; --accent: #6b8cff; --card: #1c1c1e; }
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
  margin: 0; background: var(--bg); color: var(--fg);
  font: 17px/1.65 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  padding: 24px max(16px, env(safe-area-inset-right)) 48px max(16px, env(safe-area-inset-left));
}
main { max-width: 720px; margin: 0 auto; }
.badge { display: inline-block; font-size: 12px; color: var(--muted); border: 1px solid var(--line); border-radius: 10px; padding: 1px 8px; margin-bottom: 12px; }
h1 { font-size: 26px; line-height: 1.35; margin: 0 0 6px; }
.meta { color: var(--muted); font-size: 14px; margin-bottom: 16px; }
.headline { background: var(--card); border-radius: 12px; padding: 12px 16px; margin: 16px 0 8px; }
h2 { font-size: 20px; margin: 28px 0 4px; padding-top: 12px; border-top: 1px solid var(--line); }
.item { margin: 16px 0; break-inside: avoid; }
.item h3 { font-size: 17px; margin: 0 0 4px; }
.item p, .item li { margin: 4px 0; }
.src { font-size: 13px; color: var(--muted); }
.src a { color: var(--muted); }
a { color: var(--accent); text-decoration: none; }
.footer { margin-top: 40px; font-size: 13px; color: var(--muted); text-align: center; }
.cta { display: inline-block; margin-top: 12px; padding: 10px 20px; border-radius: 22px; background: var(--accent); color: #fff; }
</style>
</head>
<body>
<main>
  {{- if .Share}}
  <div class="badge">{{.L.AILabel}}</div>
  {{- end}}
  <h1>{{.Title}}</h1>
  <div class="meta">{{.Date}} · {{printf .L.ItemCount .ItemCount}}{{if .SharedBy}} · {{printf .L.SharedBy .SharedBy}}{{end}}</div>
  {{- if .Headline}}
  <div class="headline">{{.Headline}}</div>
  {{- end}}
  {{- range .Sections}}
  <section>
    {{- if .Title}}
    <h2>{{.Title}}</h2>
    {{- end}}
    {{- range .Items}}
    <div class="item" id="item-{{.ID}}">
      <h3>{{.Title}}</h3>
      {{.Body}}
      {{- if .Sources}}
      <div class="src">{{range $i, $s := .Sources}}{{if $i}} · {{end}}{{if isWeb $s.URL}}<a href="{{$s.URL}}" rel="noopener nofollow" target="_blank">{{if $s.SiteName}}{{$s.SiteName}}{{else}}{{$s.Title}}{{end}}</a>{{else}}{{$s.Title}}{{end}}{{end}}</div>
      {{- end}}
    </div>
    {{- end}}
  </section>
  {{- end}}
  <div class="footer">
    {{.L.Disclaimer}}
    {{- if .Share}}
    <div><a class="cta" href="{{.CTAURL}}">{{.L.CTA}}</a></div>
    {{- end}}
  </div>
</main>
</body>
</html>
