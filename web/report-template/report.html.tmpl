<!doctype html>
<html lang="{{.L.HTMLLang}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{.Title}}</title>
<meta name="ai-generated" content="true">
{{- if .Share}}
<meta name="robots" content="noindex, nofollow">
<meta property="og:title" content="{{.Title}}">
<meta property="og:description" content="{{.Summary}}">
<meta name="description" content="{{.Summary}}">
{{- end}}
<style>
:root{color-scheme:light dark;--bg:#fff;--fg:#1b2332;--muted:#606b7d;--line:#e2e7ef;--accent:#2952cc;--card:#f5f7fa;--hero:#192640;--hero-text:#fff;--hero-muted:#c4d0e5;--shadow:rgba(28,41,71,.16)}
@media(prefers-color-scheme:dark){:root{--bg:#111824;--fg:#f0f3f9;--muted:#bac6d6;--line:#344255;--accent:#adc4ff;--card:#202b3a;--hero:#192640;--shadow:rgba(0,0,0,.4)}}
*{box-sizing:border-box}html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--fg);font:17px/1.7 -apple-system,BlinkMacSystemFont,"PingFang SC","Helvetica Neue",sans-serif}main{max-width:720px;margin:0 auto}.hero{background:var(--hero);color:var(--hero-text);padding:24px max(20px,env(safe-area-inset-right)) 26px max(20px,env(safe-area-inset-left))}.eyebrow{font-size:11px;letter-spacing:.06em;color:var(--hero-muted);text-transform:uppercase}.hero h1{font-size:28px;line-height:1.32;overflow-wrap:anywhere;margin:12px 0}.meta{color:var(--hero-muted);font-size:12px;margin-top:18px}.summary{color:var(--hero-text);font-size:14px;line-height:1.7;white-space:pre-wrap}.report-content{padding:22px max(20px,env(safe-area-inset-right)) 48px max(20px,env(safe-area-inset-left))}h2{font-size:21px;line-height:1.4;margin:30px 0 10px;scroll-margin-top:24px}h3{font-size:18px;line-height:1.45;margin:24px 0 8px;scroll-margin-top:24px}p,li{margin:9px 0}a{color:var(--accent);text-decoration:none;overflow-wrap:anywhere}.sources{color:var(--muted);font-size:14px}.sources ol{padding-left:22px}.sources li{overflow-wrap:anywhere}.footer{margin-top:40px;color:var(--muted);font-size:13px;text-align:center}.badge{display:inline-block;color:var(--hero-muted);font-size:12px;border:1px solid currentColor;border-radius:10px;padding:1px 8px}.cta{display:inline-block;margin-top:12px;padding:10px 20px;border-radius:22px;background:var(--accent);color:var(--bg)}.conclusion-label{display:inline-block;font-size:12px;color:var(--accent);background:color-mix(in srgb,var(--accent) 10%,var(--bg));border-radius:6px;padding:2px 7px;margin-right:6px}sup.cite a{font-size:12px;padding:0 2px}table{border-collapse:collapse;display:block;overflow-x:auto;max-width:100%;font-size:14px;margin:12px 0}th,td{border:1px solid var(--line);padding:8px 10px;text-align:left;white-space:nowrap}th{background:var(--card)}blockquote{margin:16px 0;padding:0 14px;border-left:3px solid var(--accent);color:var(--muted)}code{font-family:ui-monospace,Menlo,monospace;font-size:14px;background:var(--card);padding:2px 4px;border-radius:4px}pre{overflow:auto}pre code{display:block;padding:12px}img{max-width:100%;height:auto}
.report-chart{margin:22px 0;padding:16px;background:var(--card);border-radius:16px;break-inside:avoid}.report-chart figcaption{display:flex;flex-direction:column;line-height:1.5}.report-chart figcaption strong{font-size:15px}.report-chart figcaption span{color:var(--muted);font-size:12px}.chart-line{display:block;width:100%;height:120px;overflow:visible}.chart-rows{display:grid;gap:9px;margin:14px 0}.chart-row{display:grid;grid-template-columns:minmax(55px,auto) minmax(40px,1fr) auto;gap:8px;align-items:center;font-size:12px}.chart-label{overflow-wrap:anywhere}.chart-track{display:block;background:var(--line);height:12px;border-radius:8px}.chart-bar{display:block;background:#486cda;height:12px;border-radius:8px;min-width:0}.chart-value{font-variant-numeric:tabular-nums}.chart-source,.report-chart summary{font-size:12px;color:var(--accent)}.chart-source a{display:inline-block;min-width:44px;min-height:44px;padding:10px;text-align:center}.report-chart details{margin-top:8px}.report-chart summary{cursor:pointer;min-height:32px}.report-chart table{width:100%}
.toc-button{position:fixed;right:max(16px,env(safe-area-inset-right));top:45%;width:44px;height:44px;border:1px solid var(--line);border-radius:50%;background:var(--bg);color:var(--accent);box-shadow:0 3px 10px var(--shadow);z-index:20;touch-action:none;cursor:pointer;transition:opacity .25s}.toc-button.dim{opacity:.65}.toc-button:focus-visible{outline:3px solid var(--accent)}.toc-icon,.toc-icon:before,.toc-icon:after{position:absolute;left:12px;width:18px;height:2px;background:currentColor;border-radius:2px;content:""}.toc-icon{top:20px}.toc-icon:before{left:0;top:-6px}.toc-icon:after{left:0;top:6px;width:12px}.toc-shade{position:fixed;inset:0;background:rgba(12,20,32,.35);z-index:29}.toc-panel{position:fixed;z-index:30;right:0;top:0;bottom:0;width:min(310px,85vw);background:var(--bg);box-shadow:0 0 20px var(--shadow);padding:20px max(16px,env(safe-area-inset-right)) 20px 16px;overflow-y:auto}.toc-head{display:flex;align-items:center;justify-content:space-between;font-size:20px;font-weight:700}.toc-close{border:0;background:transparent;color:var(--muted);font-size:28px;min-width:44px;min-height:44px;cursor:pointer}.toc-current{color:var(--muted);font-size:12px}.toc-list{list-style:none;padding:0;margin:16px 0}.toc-list li{margin:2px 0}.toc-list button{display:block;text-align:left;width:100%;border:0;background:transparent;color:var(--fg);font:inherit;font-size:14px;border-radius:10px;padding:11px 12px;cursor:pointer;overflow-wrap:anywhere}.toc-list button.sub{padding-left:28px;font-size:13px}.toc-list button.active{background:color-mix(in srgb,var(--accent) 12%,var(--bg));color:var(--accent);font-weight:700}[hidden]{display:none!important}
.source-shade{position:fixed;inset:0;background:rgba(12,20,32,.35);z-index:39}.source-panel{position:fixed;z-index:40;bottom:0;left:50%;transform:translateX(-50%);width:min(720px,100%);background:var(--bg);border-radius:24px 24px 0 0;padding:20px max(20px,env(safe-area-inset-right)) max(24px,env(safe-area-inset-bottom));box-shadow:0 -4px 24px var(--shadow)}.source-heading{display:flex;justify-content:space-between;align-items:center;font-size:20px;font-weight:700}.source-close{border:0;background:none;color:var(--muted);font-size:28px;min-width:44px;min-height:44px;cursor:pointer}.source-card{background:var(--card);border-radius:16px;padding:16px;margin-top:16px;color:var(--fg);font-size:14px}.source-meta{color:var(--muted);font-size:13px;margin-top:8px}.source-original{display:inline-block;margin-top:14px;min-height:32px}@media(max-width:560px){.has-report .report-content{padding-right:max(68px,calc(env(safe-area-inset-right) + 60px))}}@media print{html{scroll-behavior:auto}.has-report .report-content{padding:20px}.chart-source a{min-width:0;min-height:0;padding:0}.toc-button,.toc-panel,.toc-shade,.source-panel,.source-shade,.cta{display:none!important}.hero{-webkit-print-color-adjust:exact;print-color-adjust:exact}.report-chart{-webkit-print-color-adjust:exact;print-color-adjust:exact}.report-chart details{display:none}a{color:inherit;text-decoration:none}}
</style>
</head>
<body{{if .Body}} class="has-report"{{end}}>
<main>
  <header class="hero">
    {{- if .Share}}<div class="badge">{{.L.AILabel}}</div>{{else}}<div class="eyebrow">ZEUS / RESEARCH</div>{{end}}
    <h1>{{.Title}}</h1>
    {{- if .Summary}}<div class="summary">{{.Summary}}</div>{{end}}
    <div class="meta">{{.DepthLabel}} · {{printf .L.SourceCount .SourceCount}}{{if .ReadMinutes}} · {{printf .L.ReadTime .ReadMinutes}}{{end}}{{if .CompletedAt}} · {{.CompletedAt}}{{end}}{{if .SharedBy}} · {{printf .L.SharedBy .SharedBy}}{{end}}</div>
  </header>
  <div class="report-content">
    {{- if .Body}}<article id="report-body">{{.Body}}</article>{{end}}
    {{- if and .Sources .Body}}<section class="sources"><h2>{{.L.Sources}}</h2><ol>
      {{- range .Sources}}<li id="src-{{.Index}}">{{if isWeb .URL}}<a href="{{.URL}}" rel="noopener nofollow" target="_blank">{{.Title}}</a>{{else}}{{.Title}}{{end}}{{if .SiteName}} · {{.SiteName}}{{end}}</li>{{end}}
    </ol></section>{{end}}
    <div class="footer">{{.L.Disclaimer}}{{if .Share}}<div><a class="cta" href="{{.AppURL}}">{{.L.CTA}}</a></div>{{end}}</div>
  </div>
</main>
{{- if .Body}}
<button class="toc-button" type="button" aria-label="{{.L.Contents}}" aria-expanded="false" aria-controls="report-toc" hidden><span class="toc-icon" aria-hidden="true"></span></button>
<div class="toc-shade" hidden></div><aside class="toc-panel" id="report-toc" role="dialog" aria-modal="true" aria-label="{{.L.Contents}}" hidden><div class="toc-head"><span>{{.L.Contents}}</span><button class="toc-close" type="button" aria-label="{{.L.Close}}">×</button></div><div class="toc-current">{{.L.CurrentSection}} <span></span></div><ol class="toc-list"></ol></aside>
<div class="source-shade" hidden></div><section class="source-panel" role="dialog" aria-modal="true" aria-label="{{.L.SourceDetails}}" hidden><div class="source-heading"><span>{{.L.SourceDetails}}</span><button class="source-close" type="button" aria-label="{{.L.SourceClose}}">×</button></div><div class="source-card"><strong class="source-name"></strong><div class="source-meta">{{.L.SourcePeriod}}: <span class="source-period"></span></div><div class="source-meta">{{.L.SourceUnit}}: <span class="source-unit"></span></div><a class="source-original" target="_blank" rel="noopener nofollow" hidden>{{.L.SourceOriginal}} ↗</a></div></section>
<script>
(function(){'use strict';const panel=document.querySelector('.source-panel'),shade=document.querySelector('.source-shade'),close=document.querySelector('.source-close'),original=document.querySelector('.source-original');let trigger=null;function hide(){panel.hidden=true;shade.hidden=true;if(trigger)trigger.focus({preventScroll:true})}document.addEventListener('click',e=>{const link=e.target.closest('.report-chart a[href^="#src-"]');if(!link)return;const source=document.getElementById(link.getAttribute('href').slice(1)),chart=link.closest('.report-chart');if(!source||!chart)return;e.preventDefault();trigger=link;document.querySelector('.source-name').textContent=source.textContent.trim();document.querySelector('.source-period').textContent=chart.dataset.period;document.querySelector('.source-unit').textContent=chart.dataset.unit;const dest=source.querySelector('a[href]');original.hidden=!dest;if(dest)original.href=dest.href;panel.hidden=false;shade.hidden=false;close.focus()});close.addEventListener('click',hide);shade.addEventListener('click',hide);document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!panel.hidden)hide()})})();
</script>
<script>
(function(){'use strict';const headings=[...document.querySelectorAll('#report-body h2, #report-body h3, .sources h2')];if(!headings.length)return;const button=document.querySelector('.toc-button'),panel=document.querySelector('.toc-panel'),shade=document.querySelector('.toc-shade'),list=document.querySelector('.toc-list'),current=document.querySelector('.toc-current span'),close=document.querySelector('.toc-close');button.hidden=false;let active=null,timer,drag=null;headings.forEach((heading,i)=>{if(!heading.id)heading.id='report-section-'+i;const li=document.createElement('li'),item=document.createElement('button');item.type='button';item.textContent=heading.textContent;item.className=heading.tagName==='H3'?'sub':'';item.addEventListener('click',()=>{setOpen(false);heading.scrollIntoView({behavior:'smooth',block:'start'});heading.setAttribute('tabindex','-1');heading.focus({preventScroll:true})});li.appendChild(item);list.appendChild(li)});function update(){let h=headings[0];for(const x of headings){if(x.getBoundingClientRect().top<=100)h=x;else break}if(h===active)return;active=h;current.textContent=' · '+h.textContent;[...list.querySelectorAll('button')].forEach((item,i)=>{let selected=headings[i]===h;item.classList.toggle('active',selected);if(selected)item.setAttribute('aria-current','location');else item.removeAttribute('aria-current')})}function setOpen(open){panel.hidden=!open;shade.hidden=!open;button.setAttribute('aria-expanded',String(open));if(open){update();panel.querySelector('.active')?.scrollIntoView({block:'nearest'});close.focus()}else button.focus({preventScroll:true})}button.addEventListener('click',()=>{if(drag&&drag.moved){drag=null;return}setOpen(panel.hidden)});close.addEventListener('click',()=>setOpen(false));shade.addEventListener('click',()=>setOpen(false));document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!panel.hidden)setOpen(false)});window.addEventListener('scroll',()=>{update();button.classList.remove('dim');clearTimeout(timer);timer=setTimeout(()=>button.classList.add('dim'),1200)},{passive:true});button.addEventListener('pointerdown',e=>{drag={start:e.clientY,top:button.getBoundingClientRect().top,moved:false};button.setPointerCapture(e.pointerId)});button.addEventListener('pointermove',e=>{if(!drag)return;let delta=e.clientY-drag.start;if(Math.abs(delta)>5)drag.moved=true;if(drag.moved)button.style.top=Math.min(window.innerHeight-60,Math.max(16,drag.top+delta))+'px'});update()})();
</script>{{end}}
</body>
</html>
