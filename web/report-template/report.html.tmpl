<!DOCTYPE html>
<html lang="{{.L.HTMLLang}}">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="{{.CSP}}">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<meta name="ai-generated" content="true">
{{- if .Share}}
<meta name="robots" content="noindex, nofollow">
<meta property="og:title" content="{{.Title}}">
<meta property="og:description" content="{{.Summary}}">
<meta name="description" content="{{.Summary}}">
{{- end}}
<style>
:root{
  /* ===== 换肤只需要改这 6 行 ===== */
  --paper:#F4F2EB;      /* 页面底色（米白） */
  --card:#FFFFFF;       /* 卡片底色 */
  --ink:#14181B;        /* 主文字（近黑） */
  --muted:#7A8188;      /* 次要文字（灰） */
  --accent:#C7F14B;     /* 强调色（荧光黄绿） */
  --deep:#0E2A21;       /* 深色块（墨绿） */

  /* 由上面派生，一般不用改 */
  --ink2:#39414A;
  --line:#DFD9CB;
  --line-soft:#EDE9DF;
  --accent-deep:#A8D62F;
  --deep2:#17402F;
  --deep3:#2C5F49;
  --warn:#BE5B2B;
  --ga:#1F6B4A;--gb:#9A7320;--gc:#A8392B;

  --sans:"PingFang SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans SC",system-ui,-apple-system,sans-serif;
  --serif:"Songti SC","Noto Serif CJK SC","Noto Serif SC","Source Han Serif SC",Georgia,"Times New Roman",serif;
  --mono:"SF Mono",ui-monospace,Menlo,Consolas,monospace;
  --shadow:0 1px 2px rgba(20,24,27,.04),0 8px 24px -12px rgba(20,24,27,.14);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:16px;line-height:1.75;-webkit-font-smoothing:antialiased}
a{color:inherit}
::selection{background:var(--accent);color:var(--deep)}

/* ===== 顶部进度条 ===== */
.progress{position:fixed;top:0;left:0;right:0;height:3px;z-index:90}
.progress i{display:block;height:100%;width:0;background:var(--accent);transition:width .1s linear}

/* ===== 封面 ===== */
.cover{position:relative;overflow:hidden;background:var(--deep);color:#fff;padding:clamp(28px,5vw,52px) clamp(20px,5vw,72px) clamp(38px,6vw,68px)}
.cover::before{content:"";position:absolute;right:-14%;top:-32%;width:62vw;height:62vw;border-radius:50%;
  background:radial-gradient(circle at 35% 35%,color-mix(in srgb,var(--accent) 22%,transparent),transparent 62%);pointer-events:none}
.brandline{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;font-size:12.5px;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.62)}
.brandline .dot{display:inline-flex;align-items:center;gap:9px}
.brandline .dot b{width:12px;height:12px;border-radius:50%;background:var(--accent);display:inline-block}
.cover h1{font-family:var(--serif);font-weight:700;font-size:clamp(38px,7vw,86px);line-height:1.05;letter-spacing:-.02em;margin:clamp(32px,5vw,58px) 0 0}
.cover h1 em{font-style:normal;color:var(--accent)}
.cover .sub{font-size:clamp(15px,1.9vw,20px);color:rgba(255,255,255,.8);max-width:36em;margin:22px 0 0;line-height:1.65}
.cover .meta{display:flex;gap:40px;flex-wrap:wrap;margin-top:clamp(34px,5vw,52px);padding-top:22px;border-top:1px solid rgba(255,255,255,.14);font-size:13px;color:rgba(255,255,255,.55)}
.cover .meta div span{display:block;color:#fff;font-size:15px;margin-top:4px}
.cover-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1px;background:rgba(255,255,255,.13);margin-top:clamp(30px,4vw,46px);border:1px solid rgba(255,255,255,.13)}
.cover-stats div{background:var(--deep);padding:18px 20px}
.cover-stats b{display:block;font-family:var(--mono);font-size:clamp(21px,2.7vw,30px);line-height:1.1;color:var(--accent);letter-spacing:-.02em}
.cover-stats span{display:block;font-size:12px;color:rgba(255,255,255,.6);margin-top:7px;line-height:1.5}

/* ===== 骨架：左侧目录 + 主内容 ===== */
.shell{display:grid;grid-template-columns:238px minmax(0,1fr);gap:clamp(24px,4vw,64px);max-width:1250px;margin:0 auto;padding:0 clamp(18px,4vw,40px) 80px}
nav.side{position:sticky;top:0;align-self:start;padding:42px 0 0;max-height:100vh;overflow:auto;scrollbar-width:none}
nav.side::-webkit-scrollbar{display:none}
nav.side .nt{font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);margin-bottom:14px}
nav.side a{display:flex;gap:10px;align-items:baseline;text-decoration:none;font-size:13px;color:var(--ink2);padding:6px 0 6px 12px;border-left:2px solid transparent;transition:.18s}
nav.side a i{font-family:var(--mono);font-size:10.5px;color:var(--muted);font-style:normal;width:18px;flex:none}
nav.side a:hover{color:var(--ink)}
nav.side a.on{color:var(--deep);border-left-color:var(--accent-deep);font-weight:600}
nav.side a.on i{color:var(--accent-deep)}
main{min-width:0;padding-top:clamp(34px,5vw,56px)}

/* ===== 章节头 ===== */
section{margin-bottom:clamp(54px,7vw,84px);scroll-margin-top:24px}
.sechead{display:flex;align-items:baseline;gap:14px;border-bottom:1px solid var(--line);padding-bottom:12px;margin-bottom:24px;flex-wrap:wrap}
.sechead .n{font-family:var(--mono);font-size:12px;background:var(--deep);color:var(--accent);padding:3px 0;min-width:34px;text-align:center;border-radius:3px;letter-spacing:.06em;flex:none}
.sechead h2{font-family:var(--serif);font-size:clamp(23px,3.1vw,34px);line-height:1.22;margin:0;font-weight:700}
.sechead .en{margin-left:auto;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);white-space:nowrap}

/* ===== 文本 ===== */
h3{font-size:17px;margin:32px 0 12px;font-weight:650}
h3::before{content:"";display:inline-block;width:6px;height:6px;background:var(--accent-deep);border-radius:1px;margin-right:9px;vertical-align:3px}
p{margin:0 0 14px;color:var(--ink2)}
.lead{font-size:17px;color:var(--ink);line-height:1.8}
strong{color:var(--ink);font-weight:650}
.hl{background:linear-gradient(transparent 58%,var(--accent) 58%);padding:0 2px}
small{font-size:12.5px;color:var(--muted)}
.quote{border-left:3px solid var(--deep);padding:4px 0 4px 20px;margin:22px 0;font-family:var(--serif);font-size:19px;line-height:1.7;color:var(--ink)}
.quote cite{display:block;font-family:var(--sans);font-size:12.5px;color:var(--muted);font-style:normal;margin-top:10px}

/* ===== 研究简报深色块 ===== */
.brief{background:var(--deep);color:#D9E2DC;border-radius:5px;padding:clamp(20px,3vw,30px);margin:0 0 8px;font-family:var(--mono);font-size:13px;line-height:1.9;overflow-x:auto}
.brief .bt{font-size:10.5px;letter-spacing:.2em;color:var(--accent);margin-bottom:14px;font-family:var(--sans);font-weight:700}
.brief b{color:#fff;font-weight:600}
.brief strong{color:var(--accent);font-weight:600}
.brief .k{color:rgba(255,255,255,.45);display:inline-block;min-width:104px}

/* ===== 网格与卡片 ===== */
.grid{display:grid;gap:14px}
.g2{grid-template-columns:repeat(auto-fit,minmax(330px,1fr))}
.g3{grid-template-columns:repeat(auto-fit,minmax(180px,1fr))}
.card{background:var(--card);border:1px solid var(--line);padding:19px 21px;border-radius:4px;box-shadow:var(--shadow)}
.card h4{margin:0 0 8px;font-size:14.5px;font-weight:650}
.card p{margin:0;font-size:13.5px;line-height:1.7}
.stat{background:var(--card);border:1px solid var(--line);border-radius:4px;padding:17px 19px;box-shadow:var(--shadow)}
.stat b{display:block;font-family:var(--mono);font-size:clamp(21px,3vw,29px);line-height:1.15;letter-spacing:-.03em;color:var(--deep)}
.stat b u{text-decoration:none;font-size:.5em;color:var(--muted);margin-left:3px}
.stat span{display:block;font-size:12.5px;color:var(--muted);margin-top:6px;line-height:1.55}

/* ===== 提示块 ===== */
.note{border-left:3px solid var(--accent-deep);background:#FBFAF5;padding:17px 21px;margin:22px 0;border-radius:0 4px 4px 0}
.note .tag{display:inline-block;font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--deep);background:var(--accent);padding:2px 7px;border-radius:2px;font-weight:700;margin-bottom:9px}
.note p{margin:0;font-size:14.5px}
.note p+p{margin-top:10px}
.warn{border-left-color:var(--warn);background:#FCF5F0}
.warn .tag{background:#F0D3C2;color:#7A3413}

/* ===== 等级标签 / 药丸 ===== */
.g{display:inline-block;font-size:10.5px;font-weight:700;letter-spacing:.06em;padding:1px 7px;border-radius:3px;font-family:var(--mono);white-space:nowrap}
.g-hi{background:#DCEFE4;color:var(--ga)}
.g-md{background:#F6EDD6;color:#7A5A12}
.g-lo{background:#F7E3DE;color:var(--gc)}
.tags{display:flex;flex-wrap:wrap;gap:7px;margin:14px 0}
.tags span{font-size:11.5px;padding:4px 10px;border:1px solid var(--line);border-radius:100px;color:var(--ink2);background:var(--card)}

/* ===== 表格 ===== */
.tw{overflow-x:auto;margin:20px 0;border:1px solid var(--line);border-radius:4px;background:var(--card)}
table{border-collapse:collapse;width:100%;font-size:13.5px;min-width:540px}
th,td{text-align:left;padding:11px 13px;border-bottom:1px solid var(--line-soft);vertical-align:top}
th{font-size:11px;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);font-weight:600;background:#FAF8F2;white-space:nowrap}
tr:last-child td{border-bottom:none}
tbody tr:hover{background:#FBFAF5}
td.num,th.num{font-family:var(--mono);text-align:right;white-space:nowrap}
table.keep td:first-child,table.keep th:first-child{white-space:nowrap}
tr.dim td{opacity:.55}

/* ===== 图表容器 ===== */
figure{margin:24px 0;background:var(--card);border:1px solid var(--line);border-radius:4px;padding:22px 20px 16px;box-shadow:var(--shadow)}
figure .fig-t{font-size:14px;font-weight:650;margin-bottom:2px}
figure .fig-s{font-size:12px;color:var(--muted);margin-bottom:14px}
figure svg{display:block;width:100%;height:auto;overflow:visible}
figcaption{font-size:11.5px;color:var(--muted);margin-top:14px;line-height:1.6;border-top:1px solid var(--line-soft);padding-top:10px}
svg .gridline{stroke:#EFEBE1;stroke-width:1}
svg .axis{stroke:#E3DED2;stroke-width:1}
svg .lbl{font-size:12px;fill:#6E767D}
svg .lbl-d{font-size:12px;fill:var(--ink);font-weight:600}
svg .val{font-size:12.5px;fill:var(--deep);font-weight:650;font-family:var(--mono)}
#c4wrap{max-width:450px;margin:0 auto}

/* ===== 漏斗 ===== */
.funnel{margin:24px 0}
.funnel .tier{position:relative;margin:0 auto 10px;border-radius:3px;padding:16px 20px;color:#fff;display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}
.funnel .tier.t1{background:var(--deep);width:100%}
.funnel .tier.t2{background:var(--deep3);width:76%}
.funnel .tier.t3{background:var(--accent);color:var(--deep);width:52%}
.funnel .tier b{font-family:var(--mono);font-size:19px}
.funnel .tier span{font-size:12px;opacity:.85}
.funnel .cap{text-align:center;font-size:11.5px;color:var(--muted);margin-top:6px}

/* ===== 信号列表（强/弱） ===== */
.sig{display:flex;gap:14px;align-items:flex-start;padding:13px 0;border-bottom:1px solid var(--line-soft)}
.sig:last-child{border-bottom:none}
.sig .ico{flex:none;width:22px;height:22px;border-radius:50%;display:grid;place-items:center;font-size:11px;font-weight:700;font-family:var(--mono);margin-top:2px}
.sig.strong .ico{background:#DCEFE4;color:var(--ga)}
.sig.weak .ico{background:#F2E7E3;color:var(--gc)}
.sig .txt b{display:block;font-size:14px;font-weight:650;margin-bottom:2px}
.sig .txt span{font-size:12.5px;color:var(--muted);line-height:1.6}

/* ===== 计算器 ===== */
.calc{background:var(--deep);color:#fff;border-radius:5px;padding:clamp(22px,3vw,32px);margin:26px 0}
.calc h4{margin:0 0 4px;font-size:17px;font-weight:650;color:#fff}
.calc .ch-sub{font-size:12.5px;color:rgba(255,255,255,.55);margin-bottom:24px}
.calc-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:clamp(22px,3vw,40px)}
.calc-row{margin-bottom:15px}
.calc-row label{display:flex;justify-content:space-between;font-size:12.5px;color:rgba(255,255,255,.68);margin-bottom:7px;gap:12px}
.calc-row label b{font-family:var(--mono);color:var(--accent);font-weight:600}
input[type=range]{-webkit-appearance:none;width:100%;height:3px;background:rgba(255,255,255,.22);border-radius:2px;outline:none}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:15px;height:15px;border-radius:50%;background:var(--accent);cursor:pointer;border:3px solid var(--deep)}
input[type=range]::-moz-range-thumb{width:15px;height:15px;border-radius:50%;background:var(--accent);cursor:pointer;border:3px solid var(--deep)}
.calc-out{border-left:1px solid rgba(255,255,255,.14);padding-left:clamp(18px,3vw,34px)}
.calc-out .o{padding:11px 0;border-bottom:1px solid rgba(255,255,255,.1);display:flex;justify-content:space-between;align-items:baseline;gap:12px}
.calc-out .o:last-child{border-bottom:none}
.calc-out .o span{font-size:12.5px;color:rgba(255,255,255,.62)}
.calc-out .o b{font-family:var(--mono);font-size:18px}
.calc-out .o.big b{font-size:26px;color:var(--accent)}
.calc-out .o.big span{color:#fff;font-size:13px}
.calc-foot{font-size:11px;color:rgba(255,255,255,.42);margin-top:16px;line-height:1.6}

/* ===== 结论块 ===== */
.rec{background:var(--deep);color:#fff;border-radius:6px;padding:clamp(24px,3.4vw,38px);margin:26px 0}
.rec .rt{font-size:10.5px;letter-spacing:.24em;font-family:var(--mono);color:var(--accent);margin-bottom:18px}
.rec h4{margin:0 0 8px;font-size:15px;color:var(--accent);font-weight:650}
.rec p{color:rgba(255,255,255,.82);font-size:14.5px;margin:0 0 20px}
.rec p:last-child{margin-bottom:0}
.rec strong{color:#fff}
.rec ul{margin:0 0 20px;padding-left:18px;color:rgba(255,255,255,.82);font-size:14.5px}
.rec li{margin-bottom:7px}

/* ===== 列表 ===== */
ul.clean{list-style:none;padding:0;margin:16px 0}
ul.clean li{position:relative;padding-left:22px;margin-bottom:11px;font-size:14.5px;color:var(--ink2);line-height:1.72}
ul.clean li::before{content:"";position:absolute;left:0;top:10px;width:7px;height:7px;border-radius:1px;background:var(--accent-deep)}
ol.steps{counter-reset:s;list-style:none;padding:0;margin:18px 0}
ol.steps li{counter-increment:s;position:relative;padding-left:38px;margin-bottom:16px;font-size:14.5px;color:var(--ink2)}
ol.steps li::before{content:counter(s,decimal-leading-zero);position:absolute;left:0;top:1px;font-family:var(--mono);font-size:11px;color:var(--accent-deep);font-weight:700}

/* ===== 色板 ===== */
.sw{display:inline-block;width:15px;height:15px;border-radius:3px;vertical-align:-3px;margin-right:7px;border:1px solid rgba(0,0,0,.1)}
.src-list{font-size:12.5px;color:var(--muted);line-height:1.9;padding-left:18px}
.src-list li{margin-bottom:6px}
/* ===== 引用块 ===== */
.refs{list-style:none;padding:0;margin:22px 0;counter-reset:ref}
.refs li{position:relative;padding:15px 0 15px 46px;border-bottom:1px solid var(--line-soft);
  font-size:13.5px;line-height:1.7;color:var(--ink2);scroll-margin-top:24px;counter-increment:ref}
.refs li:last-child{border-bottom:none}
.refs li::before{content:"[" counter(ref) "]";position:absolute;left:0;top:16px;
  font-family:var(--mono);font-size:11.5px;color:var(--muted)}
.refs .t{font-weight:650;color:var(--ink);font-size:14px;text-decoration:none}
.refs .t:hover{text-decoration:underline;text-decoration-color:var(--accent-deep);text-underline-offset:3px}
.refs .m{display:block;font-size:12px;color:var(--muted);margin-top:4px;line-height:1.65}
.refs .m a{color:var(--deep3);text-decoration:none;border-bottom:1px solid rgba(44,95,73,.32)}
.refs .m a:hover{border-bottom-color:var(--accent-deep)}
.refs .m em{font-style:normal;color:var(--deep3);background:rgba(44,95,73,.08);
  padding:1px 5px;border-radius:2px;font-size:11.5px}
.refs li.flash{background:#FBFAF5}
.refs li.flash::before{color:var(--accent-deep);font-weight:700}
sup.cite{font-size:.68em;line-height:0;vertical-align:super}
sup.cite a{font-family:var(--mono);color:var(--deep3);text-decoration:none;padding:0 2px}
sup.cite a:hover{color:var(--accent-deep)}
footer{border-top:1px solid var(--line);padding:26px 0 0;margin-top:8px;font-size:12px;color:var(--muted);display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}
.up{position:fixed;right:22px;bottom:22px;width:42px;height:42px;border-radius:50%;background:var(--deep);color:var(--accent);border:none;cursor:pointer;font-size:16px;display:grid;place-items:center;opacity:0;pointer-events:none;transition:.25s;z-index:80;box-shadow:0 6px 20px rgba(14,42,33,.3)}
.up.show{opacity:1;pointer-events:auto}
code{font-family:var(--mono);font-size:12.5px;background:#EDE9DF;padding:1px 6px;border-radius:3px;color:#4A3F2A}
pre{background:#1B211D;color:#D9E2DC;padding:16px 18px;border-radius:4px;overflow-x:auto;font-family:var(--mono);font-size:12px;line-height:1.7;margin:16px 0}
pre .c{color:#7E8C82}

/* ===== 响应式 ===== */
@media(max-width:900px){
  .shell{grid-template-columns:1fr}
  nav.side{display:none}
  .calc-grid{grid-template-columns:1fr}
  .calc-out{border-left:none;border-top:1px solid rgba(255,255,255,.14);padding-left:0;padding-top:16px}
}
@media(max-width:640px){
  .sechead .en{display:none}
  .sechead{align-items:flex-start}
  .cover-stats{grid-template-columns:1fr 1fr}
  figure{padding:16px 13px 13px}
  .brief{font-size:12px}
  .brief .k{min-width:88px}
  .funnel .t2,.funnel .t3{width:100%}
  #c1wrap,#c2wrap,#c3wrap,#c5wrap,#c6wrap{overflow-x:auto;-webkit-overflow-scrolling:touch;padding-bottom:6px}
  #c1 svg,#c2 svg,#c3 svg,#c5 svg,#c6 svg{min-width:470px}
}
@page{margin:14mm 12mm}
@media print{
  /* 关键：强制打印背景色与背景图，否则深色封面会变成白底白字 */
  *{-webkit-print-color-adjust:exact!important;print-color-adjust:exact!important}
  .progress,nav.side,.up,.toc-fab,.toc-drawer{display:none!important}
  body{background:#fff}
  .shell{display:block;max-width:none;padding:0}
  .cover{break-after:page;padding:16mm 14mm 18mm}
  /* 分页控制：标题不落单，图表/表格/卡片不跨页 */
  .sechead,h2,h3,h4{break-after:avoid}
  figure,.tw,table,.calc,.rec,.note,.card,.stat,.timeline,.funnel .tier{break-inside:avoid}
  figure,.card,.stat{box-shadow:none}
  a{text-decoration:none;color:inherit}
  p,li{orphans:3;widows:3}
}

/* ===== c- additions: share / source / chart wrappers ===== */
.c-cta{display:inline-block;margin-top:10px;padding:10px 18px;border-radius:22px;background:var(--accent);color:var(--deep);text-decoration:none;font-weight:650}
.c-ai{font-family:var(--mono);font-size:10px;letter-spacing:.12em;color:var(--accent-deep);text-transform:uppercase}
.c-ai-badge{display:inline-block;border:1px solid rgba(255,255,255,.45);border-radius:20px;padding:3px 10px;font-size:11px;letter-spacing:.08em;color:rgba(255,255,255,.86)}
.c-share-meta{color:rgba(255,255,255,.62)}
.c-chart-wrap{max-width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch;padding-bottom:6px}
.c-chart-wrap svg{min-width:470px;display:block;width:100%;height:auto;overflow:visible}
@media(min-width:641px){.c-chart-wrap svg{min-width:0}}
.c-chart-data{display:none}
.c-source-panel{position:fixed;z-index:50;left:50%;bottom:0;transform:translateX(-50%);width:min(680px,100%);background:var(--card);border-radius:18px 18px 0 0;padding:20px;box-shadow:0 -4px 24px rgba(14,42,33,.25)}
.c-source-shade{position:fixed;inset:0;background:rgba(10,26,20,.45);z-index:49}
.c-source-panel h3{font-size:18px;margin:0 0 8px}
.c-source-panel .c-source-meta{font-size:13px;color:var(--muted);margin-top:8px}
.c-source-panel .c-source-close{float:right;border:0;background:none;font-size:24px;cursor:pointer}
@media print{thead{display:table-header-group}tr{break-inside:avoid}.c-source-panel,.c-source-shade{display:none!important}}
</style>
</head>
<body>
<div class="progress"><i id="bar"></i></div>
<header class="cover">
  <div class="brandline">
    <span class="dot"><b></b>{{.Kicker}}</span>
    <span>{{if .CompletedAt}}{{.CompletedAt}}{{end}}</span>
  </div>
  <h1>{{.Title}}</h1>
  {{- if .Summary}}<p class="sub">{{.Summary}}</p>{{end}}
  <div class="cover-stats">
    <div><b>{{.SourceCount}}</b><span>{{.L.Sources}}</span></div>
    {{- if .ReadMinutes}}<div><b>{{.ReadMinutes}}</b><span>{{printf .L.ReadTime .ReadMinutes}}</span></div>{{end}}
    <div><b>{{.ChartCount}}</b><span>CHARTS</span></div>
    <div><b>{{.SectionCount}}</b><span>SECTIONS</span></div>
  </div>
  <div class="meta">
    {{- if .DepthLabel}}<div>类型<span>{{.DepthLabel}}</span></div>{{end}}
    <div>{{.L.Sources}}<span>{{printf .L.SourceCount .SourceCount}}</span></div>
    {{- if .SharedBy}}<div>分享<span>{{printf .L.SharedBy .SharedBy}}</span></div>{{end}}
    {{- if .Share}}<div><span class="c-ai-badge">{{.L.AILabel}}</span></div>{{end}}
  </div>
</header>
<div class="shell">
  <nav class="side" id="nav">
    <div class="nt">{{.L.Contents}}</div>
    {{- range .Sections}}<a href="#{{.ID}}"><i>{{.Num}}</i>{{.Title}}</a>{{end}}
  </nav>
  <main>
    {{- range .Sections}}
    <section id="{{.ID}}">
      <div class="sechead"><span class="n">{{.Num}}</span><h2>{{.Title}}</h2><span class="en">{{.EN}}</span></div>
      {{.Body}}
    </section>
    {{- end}}
    <footer>
      <span>{{.Title}}</span>
      <span>{{.L.Disclaimer}} · <span class="c-ai">AI-GENERATED</span></span>
      {{- if .Share}}<a class="c-cta" href="{{.AppURL}}">{{.L.CTA}}</a>{{end}}
    </footer>
    <div class="c-source-shade" hidden></div>
    <aside class="c-source-panel" hidden aria-label="{{.L.Sources}}">
      <button class="c-source-close" type="button" aria-label="{{.L.Sources}}">×</button>
      <h3 class="c-source-title"></h3>
      <p class="c-source-meta"></p>
      <a class="c-source-original" href="#" target="_blank" rel="noopener nofollow">{{.L.Sources}} ↗</a>
    </aside>
  </main>
</div>
<button class="up" id="up" aria-label="{{.L.Contents}}">↑</button>
{{- if .ChartData}}
<script type="application/json" id="zeus-chart-data">{{.ChartData}}</script>
<script>{{.ChartScript}}</script>
{{- end}}
<style>
/* ===== 浮动目录按钮（<=900px）：图标态、右侧固定、仅纵向拖动 ===== */
.toc-fab{position:fixed;right:22px;bottom:78px;width:46px;height:46px;z-index:86;
  display:none;align-items:center;justify-content:center;
  background:rgba(14,42,33,.94);border:1px solid rgba(255,255,255,.14);border-radius:50%;
  padding:0;cursor:ns-resize;touch-action:none;user-select:none;-webkit-user-select:none;
  -webkit-tap-highlight-color:transparent;
  box-shadow:0 8px 24px rgba(14,42,33,.3);
  transition:transform .16s,box-shadow .16s;backdrop-filter:blur(6px)}
.toc-fab.dragging{cursor:grabbing;transition:none;box-shadow:0 14px 34px rgba(14,42,33,.45)}
.toc-fab:active{transform:scale(.94)}
.toc-fab .bars{display:flex;flex-direction:column;gap:3px;pointer-events:none}
.toc-fab .bars i{display:block;width:16px;height:2px;background:var(--accent);border-radius:1px}
.toc-fab .bars i:nth-child(2){width:12px}
@media(max-width:900px){.toc-fab{display:inline-flex}}
@media(max-width:420px){.toc-fab{right:16px}}

/* ===== 抽屉：浅色、从右侧滑出 ===== */
.toc-drawer{position:fixed;inset:0;z-index:96;visibility:hidden;pointer-events:none}
.toc-drawer.open{visibility:visible;pointer-events:auto}
.toc-backdrop{position:absolute;inset:0;background:rgba(10,26,20,.45);opacity:0;transition:opacity .24s}
.toc-drawer.open .toc-backdrop{opacity:1}
.toc-panel{position:absolute;right:0;top:0;bottom:0;width:min(82vw,320px);
  background:var(--card);color:var(--ink);
  display:flex;flex-direction:column;transform:translateX(102%);
  transition:transform .28s cubic-bezier(.22,.85,.3,1);
  box-shadow:-16px 0 48px rgba(10,26,20,.22)}
.toc-drawer.open .toc-panel{transform:none}
.toc-head{display:flex;align-items:center;justify-content:space-between;
  padding:18px 18px 13px;border-bottom:1px solid var(--line);flex:none}
.toc-head span{font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--muted)}
.toc-close{background:none;border:none;color:var(--ink);font-size:22px;line-height:1;cursor:pointer;
  padding:6px 8px;margin:-6px -8px -6px 0;border-radius:4px;opacity:.5}
.toc-close:active{opacity:.9}
.toc-close:focus-visible{outline:2px solid var(--accent-deep);outline-offset:2px}
.toc-list a:focus-visible{outline:2px solid var(--accent-deep);outline-offset:-2px}
.toc-list{flex:1;overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;padding:10px 12px 24px}
.toc-list a{display:flex;gap:12px;align-items:baseline;text-decoration:none;color:var(--ink2);
  font-size:14.5px;padding:13px 12px;border-radius:5px;border-left:2px solid transparent}
.toc-list a i{font-family:var(--mono);font-size:11px;color:var(--muted);font-style:normal;
  min-width:20px;flex:none}
.toc-list a:active{background:rgba(14,42,33,.05)}
.toc-list a.on{color:var(--deep);font-weight:600;background:rgba(14,42,33,.055);
  border-left-color:var(--accent-deep)}
body.toc-locked{overflow:hidden}
@media print{.toc-fab,.toc-drawer{display:none!important}}
</style>
<button class="toc-fab" id="tocFab" type="button" aria-label="{{.L.Contents}}" aria-expanded="false" aria-controls="tocDrawer">
  <span class="bars"><i></i><i></i><i></i></span>
</button>
<div class="toc-drawer" id="tocDrawer" aria-hidden="true">
  <div class="toc-backdrop" data-toc-close></div>
  <aside class="toc-panel" role="dialog" aria-modal="true" aria-label="{{.L.Contents}}">
    <div class="toc-head"><span>{{.L.Contents}}</span><button class="toc-close" type="button" data-toc-close aria-label="{{.L.Close}}">×</button></div>
    <nav class="toc-list" id="tocList"></nav>
  </aside>
</div>
<script>{{.ShellScript}}</script>
</body>
</html>
