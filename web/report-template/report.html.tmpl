<!doctype html>
<html lang="{{.L.HTMLLang}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{.Title}}</title>
<meta name="ai-generated" content="true">
{{- if .Share}}
<meta name="robots" content="noindex, nofollow">
<meta property="og:title" content="{{.Title}}">
<meta property="og:description" content="{{.Summary}}">
<meta name="description" content="{{.Summary}}">
{{- end}}
<style>
:root{
  --safe-top:env(safe-area-inset-top,0px);--safe-bottom:env(safe-area-inset-bottom,0px);--safe-left:env(safe-area-inset-left,0px);--safe-right:env(safe-area-inset-right,0px);
  --bg:#F4F2EB;--card:#FFFFFF;--fg:#14181B;--muted:#7A8188;--line:#DFD9CB;--line-soft:#EDE9DF;
  --accent:#B8D94B;--accent-deep:#A8C23F;--deep:#0E2A21;--deep2:#17402F;--deep3:#2C5F49;--warn:#BE5B2B;
  --sans:"PingFang SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans SC",system-ui,-apple-system,sans-serif;
  --serif:"Noto Serif CJK SC","Noto Serif SC","Songti SC","Source Han Serif SC",Georgia,"Times New Roman",serif;
  --mono:"SF Mono",ui-monospace,Menlo,Consolas,monospace;
  --shadow:0 1px 2px rgba(20,24,27,.04),0 8px 24px -12px rgba(20,24,27,.14);
  color-scheme:light;
}
*{box-sizing:border-box}html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.75 var(--sans);-webkit-font-smoothing:antialiased}a{color:inherit}::selection{background:var(--accent);color:var(--deep)}
.cover{position:relative;overflow:hidden;background:var(--deep);color:#fff;padding:clamp(32px,6vw,62px) clamp(20px,6vw,78px) clamp(38px,6vw,64px)}
.cover::before{content:"";position:absolute;right:-14%;top:-34%;width:60vw;height:60vw;border-radius:50%;background:radial-gradient(circle at 35% 35%,color-mix(in srgb,var(--accent) 24%,transparent),transparent 62%);pointer-events:none}
.cover-top{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;font-size:12px;letter-spacing:.15em;text-transform:uppercase;color:rgba(255,255,255,.64)}
.cover-brand{display:inline-flex;align-items:center;gap:9px}.cover-brand b{width:12px;height:12px;border-radius:50%;background:var(--accent);display:inline-block}
.badge{display:inline-block;color:rgba(255,255,255,.86);font-size:11px;border:1px solid rgba(255,255,255,.45);border-radius:20px;padding:3px 10px;letter-spacing:.08em}
.cover h1{font-family:var(--serif);font-weight:700;font-size:clamp(38px,7.4vw,84px);line-height:1.04;letter-spacing:-.03em;overflow-wrap:anywhere;text-wrap:balance;margin:clamp(28px,5vw,54px) 0 0}
.cover h1 em{font-style:normal;color:var(--accent)}
.summary{font-size:clamp(15px,2vw,20px);color:rgba(255,255,255,.82);max-width:38em;margin:20px 0 0;line-height:1.7;white-space:pre-wrap}
.kpi-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.14);margin-top:clamp(26px,4vw,42px);min-height:66px}
.kpi-strip i{display:flex;flex-direction:column;justify-content:center;background:var(--deep);min-height:66px;border-top:2px solid rgba(184,217,75,.35);padding:11px 14px;font-family:var(--mono);font-size:9px;letter-spacing:.14em;color:rgba(255,255,255,.35);font-style:normal}.kpi-strip i::before{content:"KPI";display:block;margin-bottom:7px}.kpi-strip i::after{content:"—";display:block;font-size:18px;line-height:1;color:rgba(255,255,255,.45);font-family:var(--mono);letter-spacing:0}
.meta{display:flex;gap:28px;flex-wrap:wrap;margin-top:clamp(24px,4vw,38px);padding-top:18px;border-top:1px solid rgba(255,255,255,.14);font-size:12.5px;color:rgba(255,255,255,.56)}
.meta span{display:block;color:#fff;font-size:13.5px;margin-top:4px}
.shell{display:grid;grid-template-columns:220px minmax(0,1fr);gap:clamp(24px,4vw,58px);max-width:1180px;margin:0 auto;padding:0 clamp(18px,4vw,38px) 70px}
nav.side{position:sticky;top:0;align-self:start;padding:38px 0 0;max-height:100vh;overflow:auto;scrollbar-width:none}nav.side::-webkit-scrollbar{display:none}
nav.side .side-title{font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);margin-bottom:12px}
nav.side ol{list-style:none;margin:0;padding:0}nav.side a{display:flex;gap:9px;align-items:baseline;text-decoration:none;font-size:12.6px;color:var(--deep2);padding:6px 0 6px 11px;border-left:2px solid transparent;transition:.18s;overflow-wrap:anywhere}
nav.side a i{font-family:var(--mono);font-size:10px;color:var(--muted);font-style:normal;width:18px;flex:none}nav.side a:hover,nav.side a.on{color:var(--deep);border-left-color:var(--accent-deep);font-weight:600}
main{min-width:0}.report-content{width:100%;max-width:36em;min-width:0}
#report-body{counter-reset:section}
#report-body h2{counter-increment:section;font-family:var(--serif);font-size:clamp(25px,3.4vw,37px);line-height:1.28;letter-spacing:-.02em;margin:48px 0 16px;padding-top:14px;border-top:1px solid var(--line);scroll-margin-top:24px;overflow-wrap:anywhere}
#report-body h2:first-child{margin-top:0;border-top:none;padding-top:0}
#report-body h2::before{content:"SECTION " counter(section,decimal-leading-zero);display:block;font-family:var(--mono);font-size:10px;letter-spacing:.18em;color:var(--accent-deep);margin-bottom:6px;font-weight:600}
#report-body h3{font-size:19px;line-height:1.4;margin:30px 0 10px;scroll-margin-top:24px;color:var(--deep)}
#report-body p,#report-body li{font-size:15.5px;line-height:1.8}#report-body p{margin:12px 0}#report-body ul,#report-body ol{padding-left:24px}#report-body li{margin:8px 0;overflow-wrap:anywhere}
#report-body strong{font-weight:650}#report-body blockquote{margin:18px 0;padding:4px 0 4px 18px;border-left:3px solid var(--deep);font-family:var(--serif);font-size:18px;color:var(--deep2)}
.conclusion-label{display:inline-block;font-size:10.5px;letter-spacing:.1em;color:var(--deep);background:var(--accent);padding:1px 6px;border-radius:2px;margin-right:5px;font-weight:700;vertical-align:1px}
sup.cite a{font-family:var(--mono);font-size:10.5px;color:var(--deep3);text-decoration:none;padding:0 2px}sup.cite a:hover{color:var(--accent-deep)}
.sources{margin-top:52px;padding-top:4px;border-top:1px solid var(--line)}.sources h2{font-family:var(--serif);font-size:clamp(25px,3.4vw,37px);line-height:1.28;margin:0 0 14px;letter-spacing:-.02em}.sources ol{padding-left:0;list-style:none;margin:0;counter-reset:src}.sources li{position:relative;padding:12px 0 12px 40px;border-bottom:1px solid var(--line-soft);color:var(--muted);font-size:13.5px;overflow-wrap:anywhere}.sources li:last-child{border-bottom:none}.sources li::before{counter-increment:src;content:"[" counter(src) "]";position:absolute;left:0;top:13px;font-family:var(--mono);font-size:10.5px;color:var(--accent-deep);font-weight:700}.sources li a{color:var(--deep3);overflow-wrap:anywhere}
.footer{margin-top:44px;border-top:1px solid var(--line);padding:22px 0 0;display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap;color:var(--muted);font-size:12.5px;line-height:1.7}.footer .ai{font-family:var(--mono);font-size:10px;letter-spacing:.1em;color:var(--accent-deep);text-transform:uppercase}.cta{display:inline-block;margin-top:12px;padding:10px 20px;border-radius:22px;background:var(--accent);color:var(--deep);text-decoration:none;font-weight:650}
figure.report-visual{margin:26px 0;padding:18px 18px 14px;background:var(--card);border:1px solid var(--line);border-radius:4px;box-shadow:var(--shadow);break-inside:avoid;page-break-inside:avoid}figure.report-visual svg{display:block;width:100%;max-width:100%;height:auto}.visual-caption{font-size:12.5px;line-height:1.7;color:var(--muted);margin-top:10px}
.tw{max-width:100%;overflow-x:auto;margin:18px 0;border:1px solid var(--line);border-radius:4px;background:var(--card);box-shadow:var(--shadow)}table{width:100%;border-collapse:collapse;font-size:13.5px;min-width:520px}th,td{padding:10px 12px;border-bottom:1px solid var(--line-soft);text-align:left;white-space:nowrap}th{background:var(--deep);color:#fff;font-weight:600;font-size:12.5px}tr:last-child td{border-bottom:none}td.num{text-align:right;font-family:var(--mono);font-variant-numeric:tabular-nums}th.num{text-align:right}
.report-chart{margin:22px 0;padding:16px;background:var(--card);border:1px solid var(--line);border-radius:4px;box-shadow:var(--shadow);break-inside:avoid;page-break-inside:avoid}.report-chart figcaption{display:flex;flex-direction:column;line-height:1.5}.report-chart figcaption strong{font-size:15px}.report-chart figcaption span{color:var(--muted);font-size:12px}.chart-line{color:var(--deep);display:block;width:100%;height:120px;overflow:visible}.chart-rows{display:grid;gap:9px;margin:14px 0}.chart-row{display:grid;grid-template-columns:minmax(55px,auto) minmax(40px,1fr) auto;gap:8px;align-items:center;font-size:12px}.chart-label{overflow-wrap:anywhere}.chart-track{display:block;background:var(--line);height:12px;border-radius:8px}.chart-bar{display:block;background:var(--deep);height:12px;border-radius:8px;min-width:0}.chart-context{font-size:12px;color:var(--muted);overflow-wrap:anywhere}.chart-dot-track{position:relative;height:3px;margin:0 6px}.chart-dot{position:absolute;top:50%;width:12px;height:12px;border-radius:50%;background:var(--deep);transform:translate(-50%,-50%)}.chart-line-value{display:flex;justify-content:space-between;gap:12px;font-size:12px;color:var(--fg)}.chart-value{font-variant-numeric:tabular-nums}.chart-source,.report-chart summary{font-size:12px;color:var(--deep3)}.chart-point-source{display:inline-block;min-width:44px;min-height:44px;padding:10px;text-align:center;font-size:12px}.chart-source a{display:inline-block;min-width:44px;min-height:44px;padding:10px;text-align:center}.report-chart details{margin-top:8px}.report-chart summary{cursor:pointer;min-height:32px}.report-chart table{width:100%}.chart-print-table{display:none}
/* PR2 slots: data-bearing KPI/confidence/callout styles are reserved, not populated yet. */
.kpi-strip i{position:relative}.callout{border-left:3px solid var(--accent-deep);background:var(--card);padding:17px 20px;margin:22px 0;border-radius:0 4px 4px 0;box-shadow:var(--shadow)}.callout.warn{border-left-color:var(--warn)}.confidence{display:inline-flex;font-family:var(--mono);font-size:10px;font-weight:700;padding:2px 7px;border-radius:2px;background:var(--accent);color:var(--deep)}.confidence.low{background:var(--line-soft);color:var(--muted);border:1px solid var(--line)}
.toc-button{position:fixed;right:max(16px,env(safe-area-inset-right));bottom:max(22px,env(safe-area-inset-bottom));width:48px;height:48px;border:1px solid var(--line);border-radius:50%;background:var(--deep);color:var(--accent);box-shadow:0 3px 10px var(--shadow);z-index:30;cursor:pointer}.toc-button:focus-visible{outline:3px solid var(--accent)}.toc-icon,.toc-icon:before,.toc-icon:after{position:absolute;left:14px;width:18px;height:2px;background:currentColor;border-radius:2px;content:""}.toc-icon{top:22px}.toc-icon:before{left:0;top:-6px}.toc-icon:after{left:0;top:6px;width:12px}
.toc-shade{position:fixed;inset:0;background:rgba(10,26,20,.45);z-index:39}.toc-panel{position:fixed;z-index:40;right:0;top:0;bottom:0;width:min(84vw,330px);background:var(--card);box-shadow:-10px 0 30px rgba(14,42,33,.18);padding:max(20px,env(safe-area-inset-top)) max(16px,env(safe-area-inset-right)) max(20px,env(safe-area-inset-bottom)) max(16px,env(safe-area-inset-left));overflow-y:auto}.toc-head{display:flex;align-items:center;justify-content:space-between;font-family:var(--mono);font-size:11px;letter-spacing:.16em;color:var(--muted);margin-bottom:14px}.toc-close{border:0;background:transparent;color:var(--fg);font-size:26px;min-width:44px;min-height:44px;cursor:pointer}.toc-list{list-style:none;padding:0;margin:0}.toc-list a{display:flex;gap:10px;align-items:baseline;text-decoration:none;color:var(--deep2);font-size:13.5px;padding:10px 0;border-bottom:1px solid var(--line-soft);overflow-wrap:anywhere}.toc-list a i{font-family:var(--mono);font-size:10.5px;color:var(--muted);font-style:normal;width:20px;flex:none}
.source-shade{position:fixed;inset:0;background:rgba(10,26,20,.45);z-index:49}.source-panel{position:fixed;z-index:50;bottom:0;left:50%;transform:translateX(-50%);width:min(720px,100%);background:var(--card);border-radius:20px 20px 0 0;padding:20px max(20px,env(safe-area-inset-right)) max(24px,env(safe-area-inset-bottom));box-shadow:0 -4px 24px var(--shadow)}.source-heading{display:flex;justify-content:space-between;align-items:center;font-size:19px;font-weight:700}.source-close{border:0;background:none;color:var(--muted);font-size:28px;min-width:44px;min-height:44px;cursor:pointer}.source-card{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:16px;margin-top:16px;color:var(--fg);font-size:14px}.source-meta{color:var(--muted);font-size:13px;margin-top:8px}.source-original{display:inline-block;margin-top:14px;min-height:32px;color:var(--deep3)}
@media(max-width:900px){.shell{grid-template-columns:1fr}nav.side{display:none}.toc-button{display:inline-grid;place-items:center}.cover h1{font-size:clamp(34px,10vw,56px)}}
@media(min-width:901px){.toc-button,.toc-panel,.toc-shade{display:none!important}}
@media(max-width:560px){.cover{padding:28px 20px 34px}.kpi-strip{grid-template-columns:1fr 1fr;min-height:52px}.kpi-strip i{min-height:52px}.meta{gap:18px}.shell{padding:0 20px 54px}.tw{box-shadow:none}figure.report-visual{padding:14px 12px 11px}}
@media(max-width:360px){.chart-row{grid-template-columns:minmax(0,1fr) auto}.chart-track{grid-column:1 / -1;grid-row:2}.chart-point-source{min-height:44px}.report-chart{padding:14px}}
@media print{
  html{scroll-behavior:auto}body{background:#fff}
  .cover{break-after:page;page-break-after:always;-webkit-print-color-adjust:exact;print-color-adjust:exact}
  .toc-button,.toc-panel,.toc-shade,.source-panel,.source-shade,nav.side,.cta{display:none!important}
  .shell{display:block;max-width:none;padding:0 14mm}main{max-width:none}.report-content{max-width:36em}
  .sources{break-before:auto}.sources,.footer{break-inside:avoid}
  table{min-width:0}.tw{overflow:visible;box-shadow:none}thead{display:table-header-group}tr{break-inside:avoid}
  figure,.report-chart,figure.report-visual,.callout,.confidence{break-inside:avoid;page-break-inside:avoid;box-shadow:none}
  .report-chart{-webkit-print-color-adjust:exact;print-color-adjust:exact}figure.report-visual{-webkit-print-color-adjust:exact;print-color-adjust:exact}
  .report-chart details{display:none}.chart-print-table{display:block!important}a{color:inherit;text-decoration:none}
}
</style>
</head>
<body{{if .Body}} class="has-report"{{end}}>
<header class="hero cover">
  <div class="cover-top">
    {{- if .Share}}<div class="badge">{{.L.AILabel}}</div>{{else}}<div class="cover-brand"><b></b>ZEUS / RESEARCH</div>{{end}}
    <div>{{if .CompletedAt}}{{.CompletedAt}}{{end}}</div>
  </div>
  <h1>{{.Title}}</h1>
  {{- if .Summary}}<div class="summary">{{.Summary}}</div>{{end}}
  <div class="kpi-strip" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
  <div class="meta">
    {{- if .DepthLabel}}<span>{{.DepthLabel}}</span>{{end}}
    <span>{{printf .L.SourceCount .SourceCount}}</span>
    {{- if .ReadMinutes}}<span>{{printf .L.ReadTime .ReadMinutes}}</span>{{end}}
    {{- if .SharedBy}}<span>{{printf .L.SharedBy .SharedBy}}</span>{{end}}
  </div>
</header>
<div class="shell">
  {{- if .Body}}
  <nav class="side" aria-label="{{.L.Contents}}"><div class="side-title">{{.L.Contents}}</div><ol id="toc-side"></ol></nav>
  {{- end}}
  <main>
    {{- if .Body}}<article class="report-content" id="report-body">{{.Body}}</article>{{end}}
    {{- if and .Sources .Body}}
    <section class="sources"><h2>{{.L.Sources}}</h2><ol>
      {{- range .Sources}}<li id="src-{{.Index}}">{{if isWeb .URL}}<a href="{{.URL}}" rel="noopener nofollow" target="_blank">{{.Title}}</a>{{else}}{{.Title}}{{end}}{{if .SiteName}} · {{.SiteName}}{{end}}</li>{{end}}
    </ol></section>
    {{- end}}
    <footer class="footer"><span>{{.L.Disclaimer}}</span><span class="ai">AI-GENERATED</span>{{if .Share}}<div><a class="cta" href="{{.AppURL}}">{{.L.CTA}}</a></div>{{end}}</footer>
  </main>
</div>
{{- if .Body}}
<button class="toc-button" type="button" aria-label="{{.L.Contents}}" aria-expanded="false" aria-controls="report-toc" hidden><span class="toc-icon" aria-hidden="true"></span></button>
<div class="toc-shade" hidden></div>
<aside class="toc-panel" id="report-toc" role="dialog" aria-modal="true" aria-label="{{.L.Contents}}" hidden><div class="toc-head"><span>{{.L.Contents}}</span><button class="toc-close" type="button" aria-label="{{.L.Close}}">×</button></div><ol class="toc-list" id="toc-mobile"></ol></aside>
<div class="source-shade" hidden></div>
<section class="source-panel" role="dialog" aria-modal="true" aria-label="{{.L.SourceDetails}}" hidden><div class="source-heading"><span>{{.L.SourceDetails}}</span><button class="source-close" type="button" aria-label="{{.L.SourceClose}}">×</button></div><div class="source-card"><strong class="source-name"></strong><div class="source-meta">{{.L.SourcePeriod}}: <span class="source-period"></span></div><div class="source-meta">{{.L.SourceUnit}}: <span class="source-unit"></span></div><div class="source-meta">{{.L.SourceScope}}: <span class="source-scope"></span></div><div class="source-meta source-qualifier-row" hidden>{{.L.SourceQualifier}}: <span class="source-qualifier"></span></div><a class="source-original" target="_blank" rel="noopener nofollow" hidden>{{.L.SourceOriginal}} ↗</a></div></section>
<script>
(function(){'use strict';const panel=document.querySelector('.source-panel'),shade=document.querySelector('.source-shade'),close=document.querySelector('.source-close'),original=document.querySelector('.source-original');let trigger=null;function hide(){panel.hidden=true;shade.hidden=true;if(trigger)trigger.focus({preventScroll:true})}document.addEventListener('click',e=>{const link=e.target.closest('.report-chart a[href^="#src-"]');if(!link)return;const source=document.getElementById(link.getAttribute('href').slice(1)),chart=link.closest('.report-chart');if(!source||!chart)return;e.preventDefault();trigger=link;document.querySelector('.source-name').textContent=source.textContent.trim();document.querySelector('.source-period').textContent=chart.dataset.period;document.querySelector('.source-unit').textContent=chart.dataset.unit;document.querySelector('.source-scope').textContent=chart.dataset.scope;document.querySelector('.source-qualifier').textContent=chart.dataset.qualifier;document.querySelector('.source-qualifier-row').hidden=!chart.dataset.qualifier;const dest=source.querySelector('a[href]');original.hidden=!dest;if(dest)original.href=dest.href;panel.hidden=false;shade.hidden=false;close.focus()});close.addEventListener('click',hide);shade.addEventListener('click',hide);document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!panel.hidden)hide()})})();
</script>
<script>
(function(){'use strict';const headings=[...document.querySelectorAll('#report-body h2, #report-body h3, .sources h2')];if(!headings.length)headings.push(document.querySelector('.cover h1'));const button=document.querySelector('.toc-button'),panel=document.querySelector('.toc-panel'),shade=document.querySelector('.toc-shade'),side=document.querySelector('#toc-side'),mobile=document.querySelector('#toc-mobile'),close=document.querySelector('.toc-close');if(!button||!side||!mobile)return;button.hidden=false;const links=[];headings.forEach((heading,i)=>{if(!heading.id)heading.id='report-section-'+i;const li=document.createElement('li'),a=document.createElement('a');a.href='#'+heading.id;a.innerHTML='<i>'+String(i).padStart(2,'0')+'</i>';const label=document.createElement('span');label.textContent=heading.textContent; a.appendChild(label);a.addEventListener('click',()=>{setOpen(false);heading.scrollIntoView({behavior:'smooth',block:'start'});heading.setAttribute('tabindex','-1');heading.focus({preventScroll:true})});li.appendChild(a);side.appendChild(li);const m=document.createElement('li'),b=document.createElement('a');b.href='#'+heading.id;b.innerHTML='<i>'+String(i).padStart(2,'0')+'</i><span></span>';b.querySelector('span').textContent=heading.textContent;b.addEventListener('click',()=>{setOpen(false);heading.scrollIntoView({behavior:'smooth',block:'start'});heading.setAttribute('tabindex','-1');heading.focus({preventScroll:true})});m.appendChild(b);mobile.appendChild(m);links.push({heading,a});});function setOpen(open){panel.hidden=!open;shade.hidden=!open;button.setAttribute('aria-expanded',String(open));if(open){const active=links.find(x=>x.a.classList.contains('on'))||links[0];close.focus();if(active)active.a.scrollIntoView({block:'nearest'})}else{button.focus({preventScroll:true})}}button.addEventListener('click',()=>setOpen(panel.hidden));close.addEventListener('click',()=>setOpen(false));shade.addEventListener('click',()=>setOpen(false));document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!panel.hidden)setOpen(false)});let ticking=false;function update(){ticking=false;let active=links[0];for(const item of links){if(item.heading.getBoundingClientRect().top<=120)active=item;else break}for(const item of links)item.a.classList.toggle('on',item===active)}window.addEventListener('scroll',()=>{if(!ticking){ticking=true;requestAnimationFrame(update)}},{passive:true});update()})();
</script>{{end}}
</body>
</html>
