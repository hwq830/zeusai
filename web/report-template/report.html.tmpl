<!doctype html>
<html lang="{{.L.HTMLLang}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{.Title}}</title>
{{- if .Share}}
<meta property="og:title" content="{{.Title}}">
<meta property="og:description" content="{{.Summary}}">
<meta name="description" content="{{.Summary}}">
{{- end}}
<style>
:root {
  --bg: #ffffff; --fg: #1c1c1e; --muted: #6e6e73; --line: #e5e5ea; --accent: #0a66ff; --card: #f5f5f7;
}
@media (prefers-color-scheme: dark) {
  :root { --bg: #000000; --fg: #f2f2f7; --muted: #98989d; --line: #2c2c2e; --accent: #4c8dff; --card: #1c1c1e; }
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
  margin: 0; background: var(--bg); color: var(--fg);
  font: 17px/1.7 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  padding: 24px max(16px, env(safe-area-inset-right)) 48px max(16px, env(safe-area-inset-left));
}
main { max-width: 720px; margin: 0 auto; }
h1 { font-size: 26px; line-height: 1.35; margin: 0 0 8px; }
h2 { font-size: 21px; margin: 32px 0 8px; padding-top: 8px; border-top: 1px solid var(--line); }
h3 { font-size: 18px; margin: 24px 0 8px; }
p, li { margin: 8px 0; }
a { color: var(--accent); text-decoration: none; }
.meta { color: var(--muted); font-size: 14px; margin-bottom: 24px; }
.summary { background: var(--card); border-radius: 12px; padding: 12px 16px; margin: 16px 0 24px; }
sup.cite a { font-size: 12px; padding: 0 1px; }
table { border-collapse: collapse; width: 100%; display: block; overflow-x: auto; font-size: 15px; margin: 12px 0; }
th, td { border: 1px solid var(--line); padding: 6px 10px; text-align: left; white-space: nowrap; }
th { background: var(--card); }
blockquote { margin: 12px 0; padding: 0 12px; border-left: 3px solid var(--line); color: var(--muted); }
code { font-family: ui-monospace, Menlo, monospace; font-size: 15px; background: var(--card); padding: 1px 4px; border-radius: 4px; }
pre code { display: block; padding: 12px; overflow-x: auto; }
.sources { font-size: 14px; color: var(--muted); }
.sources ol { padding-left: 22px; }
.sources li { word-break: break-all; }
.footer { margin-top: 40px; font-size: 13px; color: var(--muted); text-align: center; }
.cta { display: inline-block; margin-top: 12px; padding: 10px 20px; border-radius: 22px; background: var(--accent); color: #fff; }
</style>
</head>
<body>
<main>
  <h1>{{.Title}}</h1>
  <div class="meta">{{.DepthLabel}} · {{printf .L.SourceCount .SourceCount}}{{if .CompletedAt}} · {{.CompletedAt}}{{end}}</div>
  {{- if .Summary}}
  <div class="summary">{{.Summary}}</div>
  {{- end}}
  {{- if .Body}}
  <article>{{.Body}}</article>
  {{- end}}
  {{- if and .Sources .Body}}
  <section class="sources">
    <h2>{{.L.Sources}}</h2>
    <ol>
    {{- range .Sources}}
      <li id="src-{{.Index}}">{{if isWeb .URL}}<a href="{{.URL}}" rel="noopener nofollow" target="_blank">{{.Title}}</a>{{else}}{{.Title}}{{end}}{{if .SiteName}} · {{.SiteName}}{{end}}</li>
    {{- end}}
    </ol>
  </section>
  {{- end}}
  <div class="footer">
    {{.L.Disclaimer}}
    {{- if .Share}}
    <div><a class="cta" href="{{.AppURL}}">{{.L.CTA}}</a></div>
    {{- end}}
  </div>
</main>
</body>
</html>
